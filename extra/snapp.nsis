Unicode True
!define APPNAME "snha"
!define DESCRIPTION "SnahGui - St. Nicolas House Algorithm Application"


#Function .onInit
#  MessageBox MB_YESNO "This will install SnahGui - the St. Nicolas Application. Do you wish to continue?" IDYES gogogo
#Abort
#  gogogo:
#FunctionEnd
Function .oninstsuccess   
    Exec "$INSTDIR\snha-app.exe"   
FunctionEnd

PageEx license
   LicenseText "Welcome"
   LicenseData Welcome.txt
PageExEnd
     
PageEx license
   LicenseData License.txt
   LicenseForceSelection checkbox
PageExEnd
Page components
Page directory
Page instfiles
UninstPage uninstConfirm
UninstPage instfiles

# declare name of installer file
Outfile "snha-install.exe"
InstallDir "$PROGRAMFILES\${APPNAME}"

# open section
Section "install snha application"
    # define output path
    SetOutPath $INSTDIR

    # specify file to go in output path
    File snha-app.exe
    File snha-app.R
    File Readme.md
    File License.txt
    File Welcome.txt
    File snha.tapp
    File snha.ico
    File snappshot-01s.png
    File snappshot-02s.png

    # create a shortcut named "new shortcut" in the start menu programs directory
    # presently, the new shortcut doesn't call anything (the second field is blank)
    createDirectory "$SMPROGRAMS\${APPNAME}"
    createShortCut "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk" "$INSTDIR\snha-app.exe" "" "$INSTDIR\snha.ico"
    createShortCut "$SMPROGRAMS\${APPNAME}\${APPNAME}-uninstall.lnk" "$INSTDIR\uninstaller.exe" "" ""    
    # define uninstaller name
    WriteUninstaller $INSTDIR\uninstaller.exe
    #-------
    # default section end
SectionEnd
# create a section to define what the uninstaller does.
# the section will always be named "Uninstall"
Section "Uninstall"
 
# Always delete uninstaller first
Delete $INSTDIR\uninstaller.exe
 
# now delete installed files
Delete $INSTDIR\snha-app.exe
Delete $INSTDIR\snha-app.R
Delete $INSTDIR\Readme.md
Delete $INSTDIR\License.txt
Delete $INSTDIR\Welcome.txt
Delete $INSTDIR\snha.tapp
Delete $INSTDIR\snha.ico
Delete $INSTDIR\snappshot-01s.png
Delete $INSTDIR\snappshot-02s.png
Delete $SMPROGRAMS\${APPNAME}\${APPNAME}.lnk
Delete $SMPROGRAMS\${APPNAME}\${APPNAME}-uninstall.lnk
# Delete the directory
RMDir $INSTDIR
RMDir $SMPROGRAMS
SectionEnd

